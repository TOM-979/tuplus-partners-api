# Copia este archivo como .env y cambia los valores. El archivo .env nunca se sube al repositorio.

# Servidor
PORT=4000
NODE_ENV=development

# Dirección del frontend del Portal que puede llamar a la API (CORS)
# Si son varias, sepáralas con coma: http://localhost:5173,https://partners.tuplus.com
CORS_ORIGINS=http://localhost:5173

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tuplus_partners
DB_USER=tuplus_dev
DB_PASSWORD=cambia_esta_clave
