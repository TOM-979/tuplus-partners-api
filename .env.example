# Copia este archivo como ".env" y completa los valores reales. Nunca subas el ".env" a git.

PORT=4000
NODE_ENV=development

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tuplus_partners
DB_USER=tuplus_dev
DB_PASSWORD=cambia_esta_clave

# Dominios del navegador que pueden llamar a la API (la web y el portal), separados por coma.
# En producción: https://www.tuplus.pe,https://partners.tuplus.pe
CORS_ORIGINS=http://localhost:5173

# Clave para firmar los tokens de sesión (JWT). Cámbiala por una cadena larga y secreta.
# Puedes generar una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_larga_y_secreta

# Duración de la sesión y del cierre por inactividad (en minutos)
SESION_MINUTOS=480
INACTIVIDAD_MINUTOS=30

# Roles que deben confirmar un código enviado por correo además de su contraseña
REQUIERE_2FA_ROLES=direccion
